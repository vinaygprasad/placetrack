generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  STUDENT
}

enum PlacementStatus {
  UNPLACED
  PLACED
}

model User {
  id            String    // Roll No for student, EMP_ID for admin, 'SUPER_ADMIN' for superadmin
  role          Role      @default(STUDENT)
  academicYear  String    @default("NA") // e.g. "2024-2028" for students, "NA" for admins
  email         String?   @unique
  passwordHash  String
  isVerified    Boolean   @default(false)
  firstLogin    Boolean   @default(true)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student                 Student?
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@id([id, role, academicYear])
  @@map("users")
}

model Student {
  id                     String    @id // Roll No (e.g. "21V91A0501")
  userRole               Role      @default(STUDENT)
  academicYear           String    // e.g. "2024-2028" or "2024"
  user                   User      @relation(fields: [id, userRole, academicYear], references: [id, role, academicYear], onDelete: Cascade)
  
  // Personal Information
  surname                String?
  name                   String?
  fullName               String?
  fullNameAsPerSSC       String?
  gender                 String?   @default("Male")
  dob                    DateTime?
  branch                 String
  section                String?   // e.g. "A", "B", "C", "D"
  mobileNo               String?
  altEmail               String?
  emergencyContact       String?

  // Academic Information
  tenthCGPA              Float?
  tenthYear              Int?
  tenthBoard             String?
  tenthSchool            String?
  interDiplomaPercentage Float?
  interDiplomaBranch     String?
  interDiplomaYear       Int?
  interDiplomaCollege    String?
  interDiplomaBoard      String?
  btechCGPA              Float?
  activeBacklogs         Int       @default(0)
  eamcetRank             Int?
  jeeRank                Int?
  ecetRank               Int?

  // Family Information
  fatherName             String?
  fatherOccupation       String?
  fatherOrg              String?
  motherMaidenName       String?
  motherName             String?
  motherOccupation       String?
  motherOrg              String?

  // Other Information
  category               String?
  permanentAddress       String?
  hometown               String?
  district               String?
  state                  String?
  currentAddress         String?
  panNumber              String?
  aadharNumber           String?

  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  placement              Placement?
  placementOffers        PlacementOffer[]
  offerLetters           OfferLetter[]

  @@unique([id, userRole, academicYear])
  @@index([branch])
  @@map("students")
}

model Placement {
  id              String          @id @default(uuid())
  studentId       String          @unique
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  status          PlacementStatus @default(UNPLACED)
  companyName     String?
  packageOffered  Float?          // in LPA (Lakhs Per Annum)
  
  googleDriveFileId String?

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([companyName])
  @@map("placements")
}

model PlacementOffer {
  id                String   @id @default(uuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  companyName       String
  packageOffered    Float
  documentType      String   // 'LOI' | 'OL' | 'AL' | 'INT'
  documentFileName  String
  fileSizeBytes     Int
  mimeType          String   @default("application/pdf")
  googleDriveFileId String
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([studentId])
  @@map("placement_offers")
}

model OfferLetter {
  id                String   @id @default(uuid())
  studentId         String
  student           Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  googleDriveFileId String
  fileName          String
  fileSizeBytes     Int
  mimeType          String   @default("application/pdf")
  uploadedAt        DateTime @default(now())

  @@map("offer_letters")
}

model PasswordResetToken {
  id               String    @id @default(uuid())
  userId           String
  userRole         Role
  userAcademicYear String    @default("NA")
  user             User      @relation(fields: [userId, userRole, userAcademicYear], references: [id, role, academicYear], onDelete: Cascade)
  tokenHash        String    @unique
  expiresAt        DateTime
  usedAt           DateTime?
  createdAt        DateTime  @default(now())

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id               String    @id @default(uuid())
  userId           String
  userRole         Role
  userAcademicYear String    @default("NA")
  user             User      @relation(fields: [userId, userRole, userAcademicYear], references: [id, role, academicYear], onDelete: Cascade)
  pendingEmail     String?
  tokenHash        String    @unique
  expiresAt        DateTime
  verifiedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@map("email_verification_tokens")
}
