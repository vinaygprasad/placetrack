# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/placetrack_db?schema=public"

# Authentication secret & session config
JWT_SECRET="placetrack-super-secret-jwt-key-change-in-production-32-chars"
AUTH_SECRET="placetrack-super-secret-auth-key-change-in-production-32-chars"

# Initial Super Admin Seed Credentials
SUPER_ADMIN_EMAIL="superadmin@placetrack.edu"
SUPER_ADMIN_PASSWORD="SuperAdminPassword123!"

# Brevo API (Transactional Emails)
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="noreply@placetrack.edu"
BREVO_SENDER_NAME="PlaceTrack System"

# Google Drive API Configuration
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_DRIVE_FOLDER_ID=""

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
